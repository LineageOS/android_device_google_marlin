cc_binary {
    name: "android.hardware.power@1.1-service.marlin",

    relative_install_path: "hw",
    proprietary: true,
    owner: "qcom",

    init_rc: ["android.hardware.power@1.1-service.marlin.rc"],
    srcs: [
        "service.cpp",
        "Power.cpp",
        "power-helper.c",
        "metadata-parser.c",
        "utils.c",
        "list.c",
        "hint-data.c",
    ] + ["power-8996.c"], // Include target-specific files.

    cflags: ["-DINTERACTION_BOOST"] + ["-DEXTRA_POWERHAL_HINTS"],

    header_libs: ["libhardware_headers"],

    shared_libs: [
        "libbase",
        "libcutils",
        "libhidlbase",
        "liblog",
        "libutils",
        "android.hardware.power@1.1",
    ],

}
